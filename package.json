{
  "name": "vs",
  "version": "1.16.1",
  "description": "Plan-to-ship workflow skills for shaping ideas, building autonomously, reviewing code, and shipping PRs with agent discipline.",
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "skills",
    "plugin"
  ],
  "homepage": "https://github.com/vltansky/vs",
  "scripts": {
    "install-plugin": "bash install.sh",
    "install-plugin:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File install.ps1",
    "eval": "vitest run",
    "eval:static": "vitest run static.eval.ts",
    "eval:watch": "vitest",
    "eval:preview": "pathgrade preview browser",
    "build:mcp": "node mcp/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vltansky/vs.git"
  },
  "author": "Vlad Tansky (https://github.com/vltansky)",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@oxlint/plugins": "1.78.0",
    "@wix/pathgrade": "^1.0.23",
    "esbuild": "0.28.2",
    "oxlint": "1.78.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "zod": "4.2.0"
  }
}
